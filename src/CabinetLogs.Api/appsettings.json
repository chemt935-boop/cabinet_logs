{
  "ConnectionStrings": {
    "DefaultConnection": "Host=REPLACE_WITH_SUPABASE_DB_HOST;Port=5432;Database=postgres;Username=REPLACE_WITH_SUPABASE_DB_USER;Password=REPLACE_WITH_SUPABASE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Supabase": {
    "Url": "https://REPLACE_WITH_YOUR_PROJECT_REF.supabase.co",
    "AnonKey": "REPLACE_WITH_SUPABASE_ANON_KEY",
    "ServiceRoleKey": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY",
    "StorageBucket": "cabinet-log-photos",
    "SignedUrlExpirySeconds": 300
  },
  "PhotoUpload": {
    "MaxFileSizeBytes": 5242880,
    "MaxPhotosPerLog": 10,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "Database": {
    "AutoMigrate": false
  },
  "ApiSecurity": {
    "RequireApiKey": false,
    "ApiKeyHeaderName": "X-Api-Key",
    "ApiKey": "REPLACE_WITH_STRONG_RANDOM_API_KEY_IF_ENABLED"
  },
  "Scalar": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
